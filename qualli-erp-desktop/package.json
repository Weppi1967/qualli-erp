{
  "name": "qualli-erp-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Qualli-ERP Desktop-App für das Profilingbüro Glaser",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "electron": "electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  }
}
